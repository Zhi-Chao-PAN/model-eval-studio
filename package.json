{
  "name": "model-test-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-if-production.js && next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "test": "tsx --test src/lib/*.test.ts",
    "test:database": "tsx --test tests/report-concurrency.test.ts",
    "verify:release": "node scripts/verify-release.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:setup": "FORCE_MIGRATE=1 node scripts/migrate-if-production.js",
    "db:deploy-prod": "VERCEL_ENV=production node scripts/migrate-if-production.js",
    "typecheck": "tsc --noEmit",
    "init:admin": "tsx scripts/init-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "workflow": "4.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "nanoid@>=5.0.0 <5.1.16": "5.1.16",
      "devalue@>=5.0.0 <5.9.3": "5.9.3",
      "zod@>=4.0.0 <4.6.6": "4.6.7"
    }
  }
}
